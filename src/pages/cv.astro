---
import Layout from '../layouts/Layout.astro'
import {
  educations,
  researchExperiences,
  journalArticles,
  invitedTalks,
  awardsAndFunding,
  additionalContributions,
} from '../data'
---

<Layout>
  <div class="space-y-16">
    <div class="space-y-8">
      <h2 class="relative text-xl font-bold uppercase after:absolute after:-bottom-1 after:left-0 after:h-1 after:w-full after:bg-blue-500/20">
        Education
      </h2>
      <div class="grid grid-cols-1 gap-x-8 gap-y-4 md:grid-cols-[200px_1fr]">
        {educations.map((item) => (
          <>
            <p class="text-current/50 tabular-nums">{item.period}</p>
            <div>
              <p class="font-semibold">{item.degree}</p>
              <p>{item.institution}</p>
              {item.details.map((detail) => (
                <p class="text-sm">{detail}</p>
              ))}
            </div>
          </>
        ))}
      </div>
    </div>
    <div class="space-y-8">
      <h2 class="relative text-xl font-bold uppercase after:absolute after:-bottom-1 after:left-0 after:h-1 after:w-full after:bg-blue-500/20">
        Research Experience
      </h2>
      <div class="grid grid-cols-1 gap-x-8 gap-y-4 md:grid-cols-[200px_1fr]">
        {researchExperiences.map((item) => (
          <>
            <p class="text-current/50 tabular-nums">{item.period}</p>
            <div>
              <p class="font-semibold">{item.position}</p>
              <p>{item.details}</p>
            </div>
          </>
        ))}
      </div>
    </div>
    <div class="space-y-8">
      <h2 class="relative text-xl font-bold uppercase after:absolute after:-bottom-1 after:left-0 after:h-1 after:w-full after:bg-blue-500/20">
        Publications
      </h2>
      <div>
        <h3 class="mb-4 text-xl font-semibold">Journal Articles</h3>
        <div class="grid grid-cols-1 gap-x-8 gap-y-4 md:grid-cols-[200px_1fr]">
          {journalArticles.map((item) => (
            <>
              <p class="text-current/50 tabular-nums">{item.year}</p>
              <div>
                <p class="text-sm text-current/60">{item.authors}</p>
                <p>{item.title}</p>
                <p class="text-sm text-current/60">{item.details}</p>
              </div>
            </>
          ))}
        </div>
      </div>
    </div>
    <div class="space-y-8">
      <h2 class="relative text-xl font-bold uppercase after:absolute after:-bottom-1 after:left-0 after:h-1 after:w-full after:bg-blue-500/20">
        Invited Talks
      </h2>
      <div class="grid grid-cols-1 gap-x-8 gap-y-4 md:grid-cols-[200px_1fr]">
        {invitedTalks.map((item) => (
          <>
            <p class="text-current/50 tabular-nums">{item.year}</p>
            <div>
              <p>{item.title}</p>
              <p class="text-sm text-current/60">{item.location}</p>
            </div>
          </>
        ))}
      </div>
    </div>
    <div class="space-y-8">
      <h2 class="relative text-xl font-bold uppercase after:absolute after:-bottom-1 after:left-0 after:h-1 after:w-full after:bg-blue-500/20">
        Awards & Funding
      </h2>
      <div class="grid grid-cols-1 gap-x-8 gap-y-4 md:grid-cols-[200px_1fr]">
        {awardsAndFunding.map((item) => (
          <>
            <p class="text-current/50 tabular-nums">{item.year}</p>
            <div>
              <p>{item.title}</p>
            </div>
          </>
        ))}
      </div>
    </div>
    <div class="space-y-8">
      <h2 class="relative text-xl font-bold uppercase after:absolute after:-bottom-1 after:left-0 after:h-1 after:w-full after:bg-blue-500/20">
        Additional Contributions
      </h2>
      <div class="grid grid-cols-1 gap-x-8 gap-y-4 md:grid-cols-[200px_1fr]">
        {additionalContributions.map((item) => (
          <>
            <p class="text-current/50 tabular-nums">{item.year}</p>
            <div>
              <p>{item.title}</p>
            </div>
          </>
        ))}
      </div>
    </div>
  </div>
</Layout>
